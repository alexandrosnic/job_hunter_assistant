# Job Hunter Assistant Configuration
# Copy this to .env and customize as needed

# API Security
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JH_API_KEY=your-secure-api-key-here

# Ollama Configuration (used when provider="ollama" in config)
# Set if Ollama is running on a different host or port
# OLLAMA_BASE_URL=http://localhost:11434

# OpenAI Configuration (used when provider="openai" in config)
# Requires: pip install openai>=1.0.0
# OPENAI_API_KEY=sk-...

# Anthropic Configuration (used when provider="anthropic" in config)
# Requires: pip install anthropic>=0.10.0
# ANTHROPIC_API_KEY=sk-ant-...

# Logging
# Set to DEBUG for verbose output, INFO for normal
JH_LOG_LEVEL=INFO
